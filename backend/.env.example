# IST-RVT Backend Environment Variables
# Copy this file to .env and configure

# ─── App ─────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-string

# ─── Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────
# SQLite (default, local)
DATABASE_URL=sqlite+aiosqlite:///./ist_rvt.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ist_rvt

# ─── Redis (optional) ────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── AI Models ───────────────────────────────────────
# STT Provider: "local" (faster-whisper on CPU/GPU), "groq" (fast Cloud API), or "openai" (OpenAI API)
STT_PROVIDER=local
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Local STT Settings (only used if STT_PROVIDER=local or as API fallback)
WHISPER_MODEL=tiny
DEVICE=cpu
COMPUTE_TYPE=int8

# ─── TTS ─────────────────────────────────────────────
TTS_ENGINE=edge
VOICE_CLONE_ENABLED=false

# ─── Audio Pipeline ──────────────────────────────────
AUDIO_CHUNK_MS=100
