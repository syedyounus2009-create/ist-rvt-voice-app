# IST-RVT Backend Environment Variables
# Copy this file to .env and configure

# ─── App ─────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-string

# ─── Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────
# SQLite (default, local)
DATABASE_URL=sqlite+aiosqlite:///./ist_rvt.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ist_rvt

# ─── Redis (optional) ────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── AI Models ───────────────────────────────────────
WHISPER_MODEL=small
DEVICE=cpu
COMPUTE_TYPE=int8

# ─── TTS ─────────────────────────────────────────────
TTS_ENGINE=edge
VOICE_CLONE_ENABLED=false

# ─── Audio Pipeline ──────────────────────────────────
AUDIO_CHUNK_MS=100
